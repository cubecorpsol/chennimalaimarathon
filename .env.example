# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3000
NODE_ENV=development

# ============================================================
# GOHIGHLEVEL (GHL) CRM & CONVERSATIONS API INTEGRATION
# ============================================================
# Private Integration Token from GHL Dashboard -> Settings -> Developers
# MUST include scopes: contacts.write, conversations/message.write, conversations/message.readonly
GHL_PRIVATE_INTEGRATION_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# ============================================================
# GOOGLE SHEETS DB INTEGRATION
# ============================================================
# Spreadsheet ID from your Google Sheets URL
GOOGLE_SHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Service Account Email from Google Cloud IAM Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Private Key from the Service Account JSON file (keep the \n linebreaks exactly as shown inside quotes)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# ============================================================
# OPTIONAL DIRECT SMTP FALLBACK (If not using GoHighLevel Email)
# ============================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-character-app-password
# EMAIL_FROM="Chennimalai Marathon <noreply@marathon.com>"
