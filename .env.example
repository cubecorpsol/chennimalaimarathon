# =========================================================================
# 1. SERVER & ENVIRONMENT CONFIGURATION
# =========================================================================
PORT=3000

# development = bypass live Razorpay checkout & signature checks (local testing)
# production  = full live payment verification
NODE_ENV=development

# Base URLs (Used for payment gateway callbacks & redirects)
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# =========================================================================
# 2. DATABASE & SECURITY (MongoDB Atlas)
# =========================================================================
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/marathon?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here

# =========================================================================
# 3. ZOHO ZEPTOMAIL TRANSACTIONAL EMAIL SERVICE (SMTP)
# =========================================================================
# Host must match your ZeptoMail data centre (.in = India DC, .com = global DC).
ZEPTOMAIL_SMTP_HOST=smtp.zeptomail.in
ZEPTOMAIL_SMTP_PORT=587
# Username is the literal string "emailapikey", not an email address.
ZEPTOMAIL_SMTP_USER=emailapikey
# Mail Agent -> SMTP/API -> "Send Mail API Token".
ZEPTOMAIL_SMTP_PASS=your_zeptomail_send_mail_token_here
# Domain must be verified in ZeptoMail, else sends fail with "553 Sender is not allowed to relay".
ZEPTOMAIL_FROM_ADDRESS="Chennimalai Marathon" <noreply@chennimalaimarathon.com>

# =========================================================================
# 4. PAYMENT GATEWAY CREDENTIALS
# =========================================================================
# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# PayU Credentials (Optional Secondary Gateway)
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_MERCHANT_SALT=your_payu_merchant_salt
PAYU_MODE=test

# =========================================================================
# 5. GOOGLE SHEETS INTEGRATION
# =========================================================================
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
