# =========================================================================
# 1. SERVER CONFIGURATION
# =========================================================================
PORT=3000
NODE_ENV=development

# =========================================================================
# 2. SYSTEM OPERATION MODES (Controlled via .env only)
# =========================================================================
# Mode 1 (Demo): Set DEMO_MODE=true, DRY_RUN_MODE=false
# Mode 2 (Dry Run): Set DEMO_MODE=false, DRY_RUN_MODE=true
# Mode 3 (Production / Real Deploy): Set DEMO_MODE=false, DRY_RUN_MODE=false

DEMO_MODE=false
DRY_RUN_MODE=true

# =========================================================================
# 3. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# =========================================================================
# Test Keys start with: rzp_test_
# Live Keys start with: rzp_live_
RAZORPAY_KEY_ID=rzp_test_YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# =========================================================================
# 3.1 PAYU PAYMENT GATEWAY CREDENTIALS (HOSTED CHECKOUT)
# =========================================================================
PAYU_MERCHANT_KEY=YOUR_PAYU_MERCHANT_KEY
PAYU_MERCHANT_SALT=YOUR_PAYU_MERCHANT_SALT
PAYU_MODE=test

# =========================================================================
# 4. GOOGLE SHEETS DATABASE CREDENTIALS
# =========================================================================
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Note: Keep double quotes around the private key so line breaks (\n) work properly!
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# =========================================================================
# 5. GOHIGHLEVEL (GHL) CRM / EMAIL API
# =========================================================================
GHL_LOCATION_ID=your_ghl_location_id_here
GHL_PRIVATE_INTEGRATION_TOKEN=your_ghl_bearer_token_here

# =========================================================================
# 6. SMTP DUAL ACCOUNT CONFIGURATION (Nodemailer)
# =========================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Primary Email Account (Account 1 - First 500 Emails)
# Note: You can use either SMTP_USER_1 or GMAIL_ACCOUNT_1
SMTP_USER_1=firstaccount@gmail.com
SMTP_PASS_1=your_app_password_1_here
GMAIL_ACCOUNT_1=firstaccount@gmail.com
GMAIL_APP_PASSWORD_1=your_app_password_1_here

# Secondary Email Account (Account 2 - Next 500 Emails)
# Note: You can use either SMTP_USER_2 or GMAIL_ACCOUNT_2
SMTP_USER_2=secondaccount@gmail.com
SMTP_PASS_2=your_app_password_2_here
GMAIL_ACCOUNT_2=secondaccount@gmail.com
GMAIL_APP_PASSWORD_2=your_app_password_2_here

# =========================================================================
# 7. MONGODB DATABASE URL
# =========================================================================
DATABASE_URL=